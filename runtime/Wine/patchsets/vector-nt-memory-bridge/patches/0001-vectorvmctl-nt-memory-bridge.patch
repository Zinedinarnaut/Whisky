--- a/configure.ac
+++ b/configure.ac
@@ -3406,6 +3406,7 @@ WINE_CONFIG_MAKEFILE(programs/spoolsv)
 WINE_CONFIG_MAKEFILE(programs/start)
 WINE_CONFIG_MAKEFILE(programs/subst)
 WINE_CONFIG_MAKEFILE(programs/svchost)
+WINE_CONFIG_MAKEFILE(programs/vectorvmctl)
 WINE_CONFIG_MAKEFILE(programs/systeminfo)
 WINE_CONFIG_MAKEFILE(programs/taskkill)
 WINE_CONFIG_MAKEFILE(programs/tasklist)

diff --git a/programs/vectorvmctl/Makefile.in b/programs/vectorvmctl/Makefile.in
new file mode 100644
index 000000000000..222222222222
--- /dev/null
+++ b/programs/vectorvmctl/Makefile.in
@@ -0,0 +1,10 @@
+MODULE          = vectorvmctl.exe
+IMPORTS         = kernel32 ntdll
+EXTRADLLFLAGS   = -mconsole
+
+C_SRCS = \
+	main.c
+
+@MAKE_PROG_RULES@
+
+# Consumed by VectorKit's NT memory bridge transport.
+
diff --git a/programs/vectorvmctl/main.c b/programs/vectorvmctl/main.c
new file mode 100644
index 000000000000..333333333333
--- /dev/null
+++ b/programs/vectorvmctl/main.c
@@ -0,0 +1,433 @@
+/*
+ * vectorvmctl - NT memory bridge helper for Vector
+ *
+ * JSON-first command tool used by external clients. Memory operations use
+ * Nt* primitives so reads/writes/query stay inside Wine process management.
+ */
+
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <windows.h>
+#include <tlhelp32.h>
+#include <winternl.h>
+
+#define CAPABILITY_SCHEMA_VERSION 1
+
+static void print_json_escaped(const char *value)
+{
+    const unsigned char *c = (const unsigned char *)value;
+    while (c && *c)
+    {
+        switch (*c)
+        {
+        case '"':
+            fputs("\\\"", stdout);
+            break;
+        case '\\':
+            fputs("\\\\", stdout);
+            break;
+        case '\b':
+            fputs("\\b", stdout);
+            break;
+        case '\f':
+            fputs("\\f", stdout);
+            break;
+        case '\n':
+            fputs("\\n", stdout);
+            break;
+        case '\r':
+            fputs("\\r", stdout);
+            break;
+        case '\t':
+            fputs("\\t", stdout);
+            break;
+        default:
+            if (*c < 0x20) printf("\\u%04x", (unsigned int)*c);
+            else fputc(*c, stdout);
+            break;
+        }
+        ++c;
+    }
+}
+
+static void print_json_error(const char *message)
+{
+    fputs("{\"ok\":false,\"error\":\"", stdout);
+    print_json_escaped(message ? message : "unknown");
+    fputs("\"}\n", stdout);
+}
+
+static char *wide_to_utf8(const WCHAR *value)
+{
+    int utf8_len;
+    char *utf8;
+
+    if (!value) return NULL;
+    utf8_len = WideCharToMultiByte(CP_UTF8, 0, value, -1, NULL, 0, NULL, NULL);
+    if (utf8_len <= 0) return NULL;
+
+    utf8 = (char *)HeapAlloc(GetProcessHeap(), 0, utf8_len);
+    if (!utf8) return NULL;
+
+    if (!WideCharToMultiByte(CP_UTF8, 0, value, -1, utf8, utf8_len, NULL, NULL))
+    {
+        HeapFree(GetProcessHeap(), 0, utf8);
+        return NULL;
+    }
+    return utf8;
+}
+
+static HANDLE open_process_nt(DWORD pid)
+{
+    OBJECT_ATTRIBUTES attributes;
+    CLIENT_ID cid;
+    HANDLE process = NULL;
+    NTSTATUS status;
+
+    InitializeObjectAttributes(&attributes, NULL, 0, NULL, NULL);
+    cid.UniqueProcess = (HANDLE)(ULONG_PTR)pid;
+    cid.UniqueThread = 0;
+
+    status = NtOpenProcess(
+        &process,
+        PROCESS_QUERY_INFORMATION | PROCESS_VM_READ | PROCESS_VM_WRITE | PROCESS_VM_OPERATION,
+        &attributes,
+        &cid
+    );
+    if (status < 0) return NULL;
+    return process;
+}
+
+static const char *state_to_string(DWORD state)
+{
+    switch (state)
+    {
+    case MEM_COMMIT: return "commit";
+    case MEM_RESERVE: return "reserve";
+    case MEM_FREE: return "free";
+    default: return "unknown";
+    }
+}
+
+static const char *type_to_string(DWORD type)
+{
+    switch (type)
+    {
+    case MEM_IMAGE: return "image";
+    case MEM_MAPPED: return "mapped";
+    case MEM_PRIVATE: return "private";
+    default: return "unknown";
+    }
+}
+
+static void format_protection(DWORD protect, char out[5])
+{
+    int idx = 0;
+    BOOL has_read = FALSE;
+    BOOL has_write = FALSE;
+    BOOL has_execute = FALSE;
+    BOOL has_copy = FALSE;
+
+    switch (protect & 0xff)
+    {
+    case PAGE_READONLY:
+        has_read = TRUE;
+        break;
+    case PAGE_READWRITE:
+        has_read = TRUE;
+        has_write = TRUE;
+        break;
+    case PAGE_WRITECOPY:
+        has_read = TRUE;
+        has_copy = TRUE;
+        break;
+    case PAGE_EXECUTE:
+        has_execute = TRUE;
+        break;
+    case PAGE_EXECUTE_READ:
+        has_execute = TRUE;
+        has_read = TRUE;
+        break;
+    case PAGE_EXECUTE_READWRITE:
+        has_execute = TRUE;
+        has_read = TRUE;
+        has_write = TRUE;
+        break;
+    case PAGE_EXECUTE_WRITECOPY:
+        has_execute = TRUE;
+        has_read = TRUE;
+        has_copy = TRUE;
+        break;
+    default:
+        break;
+    }
+
+    if (has_read) out[idx++] = 'R';
+    if (has_write) out[idx++] = 'W';
+    if (has_execute) out[idx++] = 'X';
+    if (has_copy) out[idx++] = 'C';
+    if (idx == 0) out[idx++] = '-';
+    out[idx] = '\0';
+}
+
+static int decode_hex(const char *hex, unsigned char **bytes_out, SIZE_T *size_out)
+{
+    size_t i;
+    size_t len;
+    unsigned char *bytes;
+
+    if (!hex || !bytes_out || !size_out) return 0;
+
+    len = strlen(hex);
+    if (len == 0 || (len % 2) != 0) return 0;
+
+    bytes = (unsigned char *)HeapAlloc(GetProcessHeap(), 0, len / 2);
+    if (!bytes) return 0;
+
+    for (i = 0; i < len; i += 2)
+    {
+        unsigned int value;
+        char pair[3];
+        pair[0] = hex[i];
+        pair[1] = hex[i + 1];
+        pair[2] = '\0';
+        if (sscanf(pair, "%02x", &value) != 1)
+        {
+            HeapFree(GetProcessHeap(), 0, bytes);
+            return 0;
+        }
+        bytes[i / 2] = (unsigned char)value;
+    }
+
+    *bytes_out = bytes;
+    *size_out = (SIZE_T)(len / 2);
+    return 1;
+}
+
+static int cmd_bridge_capabilities(void)
+{
+    printf("{\"ok\":true,\"schemaVersion\":%d,\"capabilities\":["
+           "\"process.list\","
+           "\"module.list\","
+           "\"nt.queryVirtualMemory\","
+           "\"nt.readVirtualMemory\","
+           "\"nt.writeVirtualMemory\","
+           "\"memory.map\","
+           "\"memory.read\","
+           "\"memory.write\"]}\n",
+           CAPABILITY_SCHEMA_VERSION);
+    return 0;
+}
+
+static int cmd_process_list(void)
+{
+    HANDLE snapshot;
+    PROCESSENTRY32W entry;
+    BOOL found;
+    int first = 1;
+
+    snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+    if (snapshot == INVALID_HANDLE_VALUE)
+    {
+        print_json_error("CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS) failed");
+        return 1;
+    }
+
+    fputs("{\"ok\":true,\"processes\":[", stdout);
+
+    entry.dwSize = sizeof(entry);
+    found = Process32FirstW(snapshot, &entry);
+    while (found)
+    {
+        char *utf8_name = wide_to_utf8(entry.szExeFile);
+        const char *name = utf8_name ? utf8_name : "unknown.exe";
+
+        if (!first) fputs(",", stdout);
+        first = 0;
+
+        fputs("{\"name\":\"", stdout);
+        print_json_escaped(name);
+        printf("\",\"pid\":%lu}", entry.th32ProcessID);
+
+        if (utf8_name) HeapFree(GetProcessHeap(), 0, utf8_name);
+        found = Process32NextW(snapshot, &entry);
+    }
+
+    fputs("]}\n", stdout);
+    CloseHandle(snapshot);
+    return 0;
+}
+
+static int cmd_module_list(DWORD pid)
+{
+    HANDLE snapshot;
+    MODULEENTRY32W entry;
+    BOOL found;
+    int first = 1;
+
+    if (!pid)
+    {
+        print_json_error("missing --pid");
+        return 2;
+    }
+
+    snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPMODULE | TH32CS_SNAPMODULE32, pid);
+    if (snapshot == INVALID_HANDLE_VALUE)
+    {
+        print_json_error("CreateToolhelp32Snapshot(TH32CS_SNAPMODULE) failed");
+        return 1;
+    }
+
+    fputs("{\"ok\":true,\"modules\":[", stdout);
+    entry.dwSize = sizeof(entry);
+    found = Module32FirstW(snapshot, &entry);
+    while (found)
+    {
+        unsigned long long base = (unsigned long long)(ULONG_PTR)entry.modBaseAddr;
+        unsigned long long end = entry.modBaseSize ? base + (unsigned long long)entry.modBaseSize - 1ULL : base;
+        char *utf8_name = wide_to_utf8(entry.szModule);
+        const char *name = utf8_name ? utf8_name : "unknown";
+
+        if (!first) fputs(",", stdout);
+        first = 0;
+
+        fputs("{\"kind\":\"PE\",\"name\":\"", stdout);
+        print_json_escaped(name);
+        printf("\",\"base\":\"0x%llx\",\"end\":\"0x%llx\",\"debug\":\"-\"}", base, end);
+
+        if (utf8_name) HeapFree(GetProcessHeap(), 0, utf8_name);
+        found = Module32NextW(snapshot, &entry);
+    }
+
+    fputs("]}\n", stdout);
+    CloseHandle(snapshot);
+    return 0;
+}
+
+static int cmd_memory_map(DWORD pid)
+{
+    HANDLE process;
+    PBYTE cursor = 0;
+    MEMORY_BASIC_INFORMATION mbi;
+    SIZE_T retlen = 0;
+    int first = 1;
+
+    if (!pid)
+    {
+        print_json_error("missing --pid");
+        return 2;
+    }
+
+    process = open_process_nt(pid);
+    if (!process)
+    {
+        print_json_error("failed to open process");
+        return 1;
+    }
+
+    fputs("{\"ok\":true,\"regions\":[", stdout);
+    for (;;)
+    {
+        NTSTATUS status;
+        unsigned long long base;
+        unsigned long long size;
+        unsigned long long next;
+        DWORD protection_value;
+        char protection[5];
+
+        status = NtQueryVirtualMemory(process, cursor, MemoryBasicInformation, &mbi, sizeof(mbi), &retlen);
+        if (status < 0) break;
+
+        base = (unsigned long long)(ULONG_PTR)mbi.BaseAddress;
+        size = (unsigned long long)mbi.RegionSize;
+        protection_value = mbi.Protect ? mbi.Protect : mbi.AllocationProtect;
+        format_protection(protection_value, protection);
+
+        if (!first) fputs(",", stdout);
+        first = 0;
+        printf("{\"base\":\"0x%llx\",\"size\":%llu,\"state\":\"%s\",\"type\":\"%s\",\"protection\":\"%s\"}",
+               base,
+               size,
+               state_to_string(mbi.State),
+               type_to_string(mbi.Type),
+               protection);
+
+        if (!size) break;
+        next = base + size;
+        if (next <= base) break;
+        cursor = (PBYTE)(ULONG_PTR)next;
+    }
+
+    fputs("]}\n", stdout);
+    NtClose(process);
+    return 0;
+}
+
+static int cmd_memory_read(DWORD pid, unsigned long long address, SIZE_T size)
+{
+    HANDLE process;
+    NTSTATUS status;
+    SIZE_T bytes_read = 0;
+    unsigned char *buffer;
+    SIZE_T i;
+
+    if (!pid)
+    {
+        print_json_error("missing --pid");
+        return 2;
+    }
+
+    process = open_process_nt(pid);
+    if (!process)
+    {
+        print_json_error("failed to open process");
+        return 1;
+    }
+
+    if (!size)
+    {
+        fputs("{\"ok\":true,\"dataHex\":\"\",\"bytesRead\":0}\n", stdout);
+        NtClose(process);
+        return 0;
+    }
+
+    buffer = (unsigned char *)HeapAlloc(GetProcessHeap(), 0, size);
+    if (!buffer)
+    {
+        print_json_error("allocation failure");
+        NtClose(process);
+        return 1;
+    }
+
+    status = NtReadVirtualMemory(process, (PVOID)(ULONG_PTR)address, buffer, size, &bytes_read);
+    if (status < 0 && !bytes_read)
+    {
+        HeapFree(GetProcessHeap(), 0, buffer);
+        print_json_error("NtReadVirtualMemory failed");
+        NtClose(process);
+        return 1;
+    }
+
+    fputs("{\"ok\":true,\"dataHex\":\"", stdout);
+    for (i = 0; i < bytes_read; ++i) printf("%02x", buffer[i]);
+    printf("\",\"bytesRead\":%llu}\n", (unsigned long long)bytes_read);
+
+    HeapFree(GetProcessHeap(), 0, buffer);
+    NtClose(process);
+    return 0;
+}
+
+static int cmd_memory_write(DWORD pid, unsigned long long address, const char *hex)
+{
+    HANDLE process;
+    NTSTATUS status;
+    unsigned char *bytes = NULL;
+    SIZE_T len = 0;
+    SIZE_T bytes_written = 0;
+
+    if (!pid)
+    {
+        print_json_error("missing --pid");
+        return 2;
+    }
+    if (!decode_hex(hex, &bytes, &len))
+    {
+        print_json_error("invalid --hex payload");
+        return 2;
+    }
+
+    process = open_process_nt(pid);
+    if (!process)
+    {
+        if (bytes) HeapFree(GetProcessHeap(), 0, bytes);
+        print_json_error("failed to open process");
+        return 1;
+    }
+
+    status = NtWriteVirtualMemory(process, (PVOID)(ULONG_PTR)address, bytes, len, &bytes_written);
+    if (status < 0 && !bytes_written)
+    {
+        if (bytes) HeapFree(GetProcessHeap(), 0, bytes);
+        print_json_error("NtWriteVirtualMemory failed");
+        NtClose(process);
+        return 1;
+    }
+
+    printf("{\"ok\":true,\"bytesWritten\":%llu}\n", (unsigned long long)bytes_written);
+    if (bytes) HeapFree(GetProcessHeap(), 0, bytes);
+    NtClose(process);
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    DWORD pid = 0;
+    unsigned long long address = 0;
+    SIZE_T size = 0;
+    const char *hex = NULL;
+    int i;
+
+    if (argc < 4 || strcmp(argv[1], "--json"))
+    {
+        print_json_error("usage: vectorvmctl --json <group> <command> [args]");
+        return 2;
+    }
+
+    for (i = 4; i < argc; ++i)
+    {
+        if (!strcmp(argv[i], "--pid") && i + 1 < argc) pid = (DWORD)strtoul(argv[++i], NULL, 10);
+        else if (!strcmp(argv[i], "--address") && i + 1 < argc) address = strtoull(argv[++i], NULL, 0);
+        else if (!strcmp(argv[i], "--size") && i + 1 < argc) size = (SIZE_T)strtoull(argv[++i], NULL, 10);
+        else if (!strcmp(argv[i], "--hex") && i + 1 < argc) hex = argv[++i];
+    }
+
+    if (!strcmp(argv[2], "bridge") && !strcmp(argv[3], "capabilities"))
+        return cmd_bridge_capabilities();
+
+    if (!strcmp(argv[2], "process") && !strcmp(argv[3], "list"))
+        return cmd_process_list();
+
+    if (!strcmp(argv[2], "module") && !strcmp(argv[3], "list"))
+        return cmd_module_list(pid);
+
+    if (!strcmp(argv[2], "nt") &&
+        (!strcmp(argv[3], "query-virtual-memory") || !strcmp(argv[3], "queryVirtualMemory")))
+        return cmd_memory_map(pid);
+
+    if (!strcmp(argv[2], "nt") &&
+        (!strcmp(argv[3], "read-virtual-memory") || !strcmp(argv[3], "readVirtualMemory")))
+        return cmd_memory_read(pid, address, size);
+
+    if (!strcmp(argv[2], "nt") &&
+        (!strcmp(argv[3], "write-virtual-memory") || !strcmp(argv[3], "writeVirtualMemory")))
+        return cmd_memory_write(pid, address, hex);
+
+    if (!strcmp(argv[2], "memory") && !strcmp(argv[3], "map"))
+        return cmd_memory_map(pid);
+
+    if (!strcmp(argv[2], "memory") && !strcmp(argv[3], "read"))
+        return cmd_memory_read(pid, address, size);
+
+    if (!strcmp(argv[2], "memory") && !strcmp(argv[3], "write"))
+        return cmd_memory_write(pid, address, hex);
+
+    print_json_error("unknown command");
+    return 2;
+}
+
